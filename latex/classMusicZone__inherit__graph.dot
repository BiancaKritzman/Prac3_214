digraph "MusicZone"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="MusicZone",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Represents a music-focused festival zone."];
  Node2 -> Node1 [id="edge5_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="Zones",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classZones.html",tooltip="Represents a festival zone that can contain other components."];
  Node3 -> Node2 [id="edge6_Node000002_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="MusicFestivalObserver",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classMusicFestivalObserver.html",tooltip="Common interface for festival components that can receive notifications."];
  Node1 -> Node4 [id="edge7_Node000001_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="Artist",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classArtist.html",tooltip="Represents an artist performing within a music zone."];
  Node1 -> Node5 [id="edge8_Node000001_Node000005",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node5 [id="Node000005",label="Crowd",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classCrowd.html",tooltip="Represents the crowd and capacity of a music zone."];
}
