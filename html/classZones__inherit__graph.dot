digraph "Zones"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="Zones",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Represents a festival zone that can contain other components."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="MusicFestivalObserver",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classMusicFestivalObserver.html",tooltip="Common interface for festival components that can receive notifications."];
  Node1 -> Node3 [id="edge2_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="MusicZone",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classMusicZone.html",tooltip="Represents a music-focused festival zone."];
  Node3 -> Node4 [id="edge3_Node000003_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="Artist",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classArtist.html",tooltip="Represents an artist performing within a music zone."];
  Node3 -> Node5 [id="edge4_Node000003_Node000005",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node5 [id="Node000005",label="Crowd",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classCrowd.html",tooltip="Represents the crowd and capacity of a music zone."];
  Node1 -> Node6 [id="edge5_Node000001_Node000006",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node6 [id="Node000006",label="VendorZone",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classVendorZone.html",tooltip="Represents a festival zone containing vendor stalls."];
  Node6 -> Node7 [id="edge6_Node000006_Node000007",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node7 [id="Node000007",label="Merch",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classMerch.html",tooltip="Represents a merchandise vendor for an artist."];
  Node6 -> Node8 [id="edge7_Node000006_Node000008",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node8 [id="Node000008",label="Refreshments",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classRefreshments.html",tooltip="Represents a refreshments vendor in the festival."];
}
