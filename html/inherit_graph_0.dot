digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node0 [id="Node000000",label="MusicFestivalObserver",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classMusicFestivalObserver.html",tooltip="Common interface for festival components that can receive notifications."];
  Node0 -> Node1 [id="edge1_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 [id="Node000001",label="Gate",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classGate.html",tooltip="Represents a festival entrance or stage gate."];
  Node0 -> Node2 [id="edge2_Node000000_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="Security",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classSecurity.html",tooltip="Represents the festival security team."];
  Node0 -> Node3 [id="edge3_Node000000_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="SoundTeam",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classSoundTeam.html",tooltip="Represents the festival sound team."];
  Node0 -> Node4 [id="edge4_Node000000_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="Stage",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classStage.html",tooltip="Represents a festival performance stage."];
  Node0 -> Node5 [id="edge5_Node000000_Node000005",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node5 [id="Node000005",label="Zones",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classZones.html",tooltip="Represents a festival zone that can contain other components."];
  Node5 -> Node6 [id="edge6_Node000005_Node000006",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node6 [id="Node000006",label="MusicZone",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classMusicZone.html",tooltip="Represents a music-focused festival zone."];
  Node6 -> Node7 [id="edge7_Node000006_Node000007",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node7 [id="Node000007",label="Artist",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classArtist.html",tooltip="Represents an artist performing within a music zone."];
  Node6 -> Node8 [id="edge8_Node000006_Node000008",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node8 [id="Node000008",label="Crowd",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classCrowd.html",tooltip="Represents the crowd and capacity of a music zone."];
  Node5 -> Node9 [id="edge9_Node000005_Node000009",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node9 [id="Node000009",label="VendorZone",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classVendorZone.html",tooltip="Represents a festival zone containing vendor stalls."];
  Node9 -> Node10 [id="edge10_Node000009_Node000010",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node10 [id="Node000010",label="Merch",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classMerch.html",tooltip="Represents a merchandise vendor for an artist."];
  Node9 -> Node11 [id="edge11_Node000009_Node000011",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node11 [id="Node000011",label="Refreshments",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classRefreshments.html",tooltip="Represents a refreshments vendor in the festival."];
